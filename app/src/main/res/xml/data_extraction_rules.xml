<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
        <exclude domain="root" path="app_webview_cache" />
        <exclude domain="file" path="chat-files" />
        <exclude domain="file" path="chat-outbox.json" />
        <exclude domain="file" path="chat-outbox.json.part" />
        <exclude domain="sharedpref" path="aird.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
        <exclude domain="root" path="app_webview_cache" />
        <exclude domain="file" path="chat-files" />
        <exclude domain="file" path="chat-outbox.json" />
        <exclude domain="file" path="chat-outbox.json.part" />
        <exclude domain="sharedpref" path="aird.xml" />
    </device-transfer>
</data-extraction-rules>
